script = ExtResource("1_62qif")
mail_id = "mail_glitchie_joke"
sender = "Глитчи"
subject = "Не открывай это письмо"
body = "Ты его открыл.Я так и знал.Ладно, раз уж открыл — привет. Это я, Глитчи. Пишу сам себе, чтобы проверить, работает ли почтовый клиент.Работает. Отлично. Теперь ты знаешь, что я умею писать письма. Не благодари.P.S. Не отвечай на это письмо. Я не читаю ответы. Я их удаляю."
reward = 0
